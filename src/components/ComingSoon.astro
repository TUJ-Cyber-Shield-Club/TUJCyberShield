---
import { DEFAULT_LOCALE, type LocaleCode } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: LocaleCode;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
---

<div class="soon" role="status" aria-label={t('soon.aria')}>
  <p class="soon-scan" aria-hidden="true"><span></span></p>
  <p class="kick soon-kick">{t('soon.kick')}</p>
  <h2 class="soon-h">{t('soon.h')}</h2>
  <p class="soon-body">{t('soon.body')}</p>
</div>

<style>
  /* The empty-archive state: a quiet "stand by" notice, styled like the
     databar/console voice rather than a warning (the archive isn't broken,
     it just hasn't started yet). */
  .soon {
    max-width: 42rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 7vw, 4rem) clamp(1.5rem, 4vw, 3rem);
    border: 1px dashed var(--accent-line);
    border-radius: 8px;
    background: var(--bg-raised);
    text-align: center;
  }

  /* A small animated scan line at the top of the panel: "signal pending". */
  .soon-scan {
    margin: 0 0 1.6rem;
    height: 3px;
    border-radius: 2px;
    overflow: hidden;
    background: var(--line);
  }

  .soon-scan span {
    display: block;
    height: 100%;
    width: 34%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    animation: soon-sweep 2.6s var(--ease-out) infinite;
  }

  @keyframes soon-sweep {
    0% {
      transform: translateX(-110%);
    }
    60%,
    100% {
      transform: translateX(320%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .soon-scan span {
      animation: none;
      transform: translateX(100%);
    }
  }

  .soon-kick {
    color: var(--accent);
  }

  .soon-h {
    margin-top: 0.8rem;
    font-size: clamp(1.7rem, 4.6vw, 2.4rem);
    letter-spacing: -0.025em;
  }

  .soon-body {
    max-width: 32rem;
    margin: 1rem auto 0;
    font-family: var(--font-body);
    font-size: 1.06rem;
    line-height: 1.65;
    color: var(--text-muted);
  }
</style>
