---
import { Image } from 'astro:assets';
import shield from '../assets/logo-shield.png';
import ThemeToggle from './ThemeToggle.astro';
import { withBase } from '../utils/articles';

const joinForm =
  'https://docs.google.com/forms/d/e/1FAIpQLSf8e37fWWAWD6axVy3mzr_sbEWz8ce-pZ0NZT-cZfEaTNVqkA/viewform?usp=header';

const home = withBase('/');
const links = [
  { href: home, label: 'Home' },
  { href: withBase('/articles/'), label: 'Articles' },
  { href: withBase('/issues/'), label: 'Issues' },
  { href: withBase('/team/'), label: 'Team' },
  { href: withBase('/about/'), label: 'About' },
];

// Normalize trailing slashes so "/base" and "/base/" compare equal.
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const target = href.replace(/\/$/, '') || '/';
  // Home should only light up on the home page, never as a prefix of others.
  return href === home ? current === target : current === target || current.startsWith(`${target}/`);
};
---

<header class="site-header">
  <div class="signalbar" aria-hidden="true">
    <div class="wrap signalbar-row">
      <p class="signalbar-left">
        <span class="pulse-dot"></span>TUJ Cyber Shield Club — student-run, open to all
      </p>
      <p class="signalbar-right">Digital safety briefing · published monthly</p>
    </div>
  </div>

  <div class="wrap bar">
    <a class="brand" href={withBase('/')}>
      <span class="brand-chip corner-frame">
        <Image
          src={shield}
          alt="TUJ Cyber Shield club logo: an owl holding a padlock on a teal shield"
          width="72"
          height="72"
          loading="eager"
        />
      </span>
      <span class="brand-text">
        <span class="brand-name">Cyber Shield</span>
        <span class="brand-sub">TUJ student publication</span>
      </span>
    </a>

    <nav aria-label="Site">
      <ul>
        {
          links.map(({ href, label }, i) => (
            <li>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                <span class="nav-index" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                {label}
              </a>
            </li>
          ))
        }
        <li class="nav-toggle"><ThemeToggle /></li>
        <li class="nav-join">
          <a class="join-link" href={joinForm} target="_blank" rel="noopener">Join the club</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: var(--header-bg);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    transition: box-shadow var(--dur) var(--ease-out);
  }

  .site-header.is-scrolled {
    box-shadow: 0 1px 0 var(--line), 0 12px 32px rgb(0 0 0 / 0.08);
  }

  /* --- the signal bar: a whisper of console text above the masthead --- */
  .signalbar {
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .signalbar-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 0.42rem;
  }

  .signalbar-left {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent-line);
    animation: pulse 2.6s var(--ease-out) infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 var(--accent-line);
    }
    60% {
      box-shadow: 0 0 0 7px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  /* --- main bar ---------------------------------------------------------- */

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 0.75rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    color: inherit;
  }

  .brand-chip {
    display: grid;
    place-items: center;
    width: 3.1rem;
    height: 3.1rem;
    border-radius: 8px;
    background: var(--bg-inset);
    border: 1px solid var(--line);
    transition: border-color var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .brand-chip img {
    width: 2.4rem;
    height: 2.4rem;
  }

  .brand:hover .brand-chip {
    border-color: var(--accent-line);
    transform: rotate(-2deg);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.12;
  }

  .brand-name {
    font-weight: 780;
    font-size: 1.32rem;
    letter-spacing: -0.02em;
  }

  .brand-sub {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 450;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: 0.18rem;
  }

  .brand:hover .brand-name {
    color: var(--accent-strong);
  }

  /* --- nav --------------------------------------------------------------- */

  nav ul {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.1rem clamp(0.15rem, 1.5vw, 0.6rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a:not(.join-link) {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    padding: 0.5rem 0.55rem;
    border-radius: 4px;
    color: var(--text);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
  }

  .nav-index {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    color: var(--accent);
    opacity: 0.75;
  }

  nav a:not(.join-link)::after {
    content: '';
    position: absolute;
    left: 0.55rem;
    right: 100%;
    bottom: 0.28rem;
    height: 2px;
    background: var(--accent);
    transition: right var(--dur) var(--ease-out);
  }

  nav a:not(.join-link):hover {
    color: var(--accent-strong);
  }

  nav a:not(.join-link):hover::after {
    right: 0.55rem;
  }

  nav a[aria-current='page'] {
    color: var(--accent);
  }

  nav a[aria-current='page']::after {
    right: 0.55rem;
  }

  .nav-toggle {
    margin-left: 0.35rem;
  }

  .join-link {
    display: inline-block;
    margin-left: 0.35rem;
    padding: 0.5rem 0.95rem;
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 650;
    font-size: 0.88rem;
    text-decoration: none;
    clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 0 100%);
    transition: background var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }

  .join-link:hover {
    background: var(--accent-strong);
    color: var(--accent-contrast);
    transform: translateY(-1px);
  }

  @media (max-width: 56rem) {
    .signalbar {
      display: none;
    }
  }

  @media (max-width: 34rem) {
    .nav-join {
      display: none;
    }

    .nav-index {
      display: none;
    }
  }
</style>
