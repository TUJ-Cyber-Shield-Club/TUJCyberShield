---
import { Image } from 'astro:assets';
import shield from '../assets/logo-shield.png';
import ThemeToggle from './ThemeToggle.astro';
import LanguagePicker from './LanguagePicker.astro';
import { withBase } from '../utils/articles';
import { DEFAULT_LOCALE, type LocaleCode } from '../i18n/config';
import { localePath, useTranslations } from '../i18n/utils';

interface Props {
  lang?: LocaleCode;
  /** Forwarded to the language picker; see its `target` prop. */
  langTarget?: string;
}

const { lang = DEFAULT_LOCALE, langTarget } = Astro.props;
const t = useTranslations(lang);

const joinForm =
  'https://docs.google.com/forms/d/e/1FAIpQLSf8e37fWWAWD6axVy3mzr_sbEWz8ce-pZ0NZT-cZfEaTNVqkA/viewform?usp=header';

// Nav targets are built per locale, so /ja/ pages link to /ja/ pages.
const home = withBase(localePath(lang, '/'));
const links = [
  { href: home, label: t('nav.home') },
  { href: withBase(localePath(lang, '/articles/')), label: t('nav.articles') },
  { href: withBase(localePath(lang, '/issues/')), label: t('nav.issues') },
  { href: withBase(localePath(lang, '/team/')), label: t('nav.team') },
  { href: withBase(localePath(lang, '/about/')), label: t('nav.about') },
];

// Normalize trailing slashes so "/base" and "/base/" compare equal.
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const target = href.replace(/\/$/, '') || '/';
  // Home should only light up on the home page, never as a prefix of others.
  return href === home ? current === target : current === target || current.startsWith(`${target}/`);
};
---

<header class="site-header">
  <div class="signalbar" aria-hidden="true">
    <div class="wrap signalbar-row">
      <p class="signalbar-left">
        <span class="pulse-dot"></span>{t('header.signal.left')}
      </p>
      <p class="signalbar-right">{t('header.signal.right')}</p>
    </div>
  </div>

  <div class="wrap bar">
    <a class="brand" href={home}>
      <span class="brand-chip corner-frame">
        <Image
          src={shield}
          alt={t('brand.logoAlt')}
          width="72"
          height="72"
          loading="eager"
        />
      </span>
      <span class="brand-text">
        <span class="brand-name">Cyber Shield</span>
        <span class="brand-sub">{t('brand.sub')}</span>
      </span>
    </a>

    {/* Wide screens: everything inline. Hidden below 64rem, where the menu
        sheet below takes over. */}
    <nav class="nav-desktop" aria-label={t('nav.aria.site')}>
      <ul>
        {
          links.map(({ href, label }) => (
            <li>
              <a class="nav-link" href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
        <li class="nav-control"><LanguagePicker lang={lang} target={langTarget} /></li>
        <li class="nav-control"><ThemeToggle lang={lang} /></li>
        <li class="nav-join">
          <a class="join-link" href={joinForm} target="_blank" rel="noopener">{t('header.join')}</a>
        </li>
      </ul>
    </nav>

    {/* Narrow screens: brand, the join action, and a menu toggle on one row.
        A <details> disclosure, so the menu opens and every link works with
        no JavaScript; the script below only adds Esc / outside-click close. */}
    <div class="bar-mobile">
      <a class="join-link join-link--compact" href={joinForm} target="_blank" rel="noopener">
        {t('header.joinShort')}
      </a>
      <details class="menu" data-menu>
        <summary class="menu-toggle">
          <svg class="icon-open" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg class="icon-close" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
          <span class="menu-label">{t('nav.menu')}</span>
        </summary>
        <div class="menu-sheet">
          <nav aria-label={t('nav.aria.site')}>
            <ul class="menu-links">
              {
                links.map(({ href, label }) => (
                  <li>
                    <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                      {label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <div class="menu-controls">
            <LanguagePicker lang={lang} target={langTarget} />
            <ThemeToggle lang={lang} />
            <a class="button menu-join" href={joinForm} target="_blank" rel="noopener">
              {t('header.join')}
            </a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Progressive enhancement for the mobile menu: close on Esc (returning
  // focus to the toggle), on a click outside, and when the viewport grows
  // past the breakpoint so a stale open sheet never lingers.
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('[data-menu]')) {
    const toggle = menu.querySelector('summary');
    menu.addEventListener('keydown', (event) => {
      // The language picker nested inside handles its own Esc first.
      if (event.key === 'Escape' && menu.open && !event.defaultPrevented) {
        menu.open = false;
        toggle?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (event) => {
      if (event.matches) menu.open = false;
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: var(--header-bg);
    transition: box-shadow var(--dur) var(--ease-out);
  }

  .site-header.is-scrolled {
    box-shadow: 0 1px 0 var(--line), 0 12px 32px rgb(0 0 0 / 0.08);
  }

  /* --- the signal bar: a whisper of console text above the masthead --- */
  .signalbar {
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .signalbar-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 0.42rem;
  }

  .signalbar-left {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  /* A few beats of "live" on load, then still: a loop that never ends pulls
     the eye every time it returns to the top of the page. */
  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent-line);
    animation: pulse 2.6s var(--ease-out) 3;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 var(--accent-line);
    }
    60% {
      box-shadow: 0 0 0 7px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  /* --- main bar ---------------------------------------------------------- */

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.75rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }

  .brand-chip {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.1rem;
    height: 3.1rem;
    border-radius: 8px;
    background: var(--bg-inset);
    border: 1px solid var(--line);
    transition: border-color var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .brand-chip img {
    width: 2.4rem;
    height: 2.4rem;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.12;
    min-width: 0;
  }

  .brand-name {
    font-weight: 780;
    font-size: 1.32rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .brand-sub {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 450;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: 0.18rem;
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .brand:hover .brand-chip {
      border-color: var(--accent-line);
      transform: rotate(-2deg);
    }

    .brand:hover .brand-name {
      color: var(--accent-strong);
    }
  }

  /* --- desktop nav ------------------------------------------------------- */

  .nav-desktop ul {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(0.15rem, 1vw, 0.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    padding: 0.5rem 0.55rem;
    border-radius: 4px;
    color: var(--text);
    font-weight: 600;
    font-size: 0.92rem;
    white-space: nowrap;
    text-decoration: none;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.55rem;
    right: 100%;
    bottom: 0.28rem;
    height: 2px;
    background: var(--accent);
    transition: right var(--dur) var(--ease-out);
  }

  .nav-link:hover {
    color: var(--accent-strong);
  }

  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    right: 0.55rem;
  }

  .nav-link[aria-current='page'] {
    color: var(--accent);
  }

  .nav-control {
    margin-left: 0.35rem;
  }

  /* The compact sibling of .button in global.css — same machined treatment,
     lighter shadow so it doesn't sit heavy inside the header bar. */
  .join-link {
    display: inline-block;
    margin-left: 0.35rem;
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--accent-strong);
    border-radius: 6px;
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 650;
    font-size: 0.88rem;
    white-space: nowrap;
    text-decoration: none;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.22),
      0 1px 2px rgb(0 0 0 / 0.14);
    transition: background var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out),
      transform 160ms var(--ease-out), box-shadow var(--dur) var(--ease-out);
  }

  .join-link:hover {
    background: var(--accent-strong);
    border-color: var(--accent-strong);
    color: var(--accent-contrast);
  }

  .join-link:active {
    transform: scale(0.97);
    box-shadow: inset 0 2px 4px rgb(0 0 0 / 0.22);
  }

  /* --- mobile bar + menu sheet ------------------------------------------- */

  .bar-mobile {
    display: none;
    align-items: center;
    gap: 0.5rem;
  }

  .join-link--compact {
    margin: 0;
    padding: 0.45rem 0.75rem;
    font-size: 0.84rem;
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.3rem;
    padding-inline: 0.65rem;
    border: 1px solid var(--control-border);
    border-radius: 6px;
    color: var(--text);
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: border-color var(--dur) var(--ease-out), background var(--dur) var(--ease-out);
  }

  .menu-toggle::-webkit-details-marker {
    display: none;
  }

  .menu-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .menu[open] .menu-toggle {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .menu-toggle svg {
    flex: none;
  }

  .icon-close,
  .menu[open] .icon-open {
    display: none;
  }

  .menu[open] .icon-close {
    display: block;
  }

  /* Full-width panel hanging from the header's bottom edge. Positioned
     against .site-header (the nearest positioned ancestor via sticky). */
  .menu-sheet {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    padding: 0.5rem clamp(1.25rem, 4vw, 2.5rem) 1.25rem;
    background: var(--header-bg);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.16);
    animation: sheet-in 200ms var(--ease-out);
  }

  /* Closed <details> content is only content-visibility-hidden in current
     Chromium, so it still counts toward the page's scroll width; take the
     sheet out of layout entirely until the menu opens. */
  .menu:not([open]) .menu-sheet {
    display: none;
  }

  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  .menu-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu-links a {
    display: flex;
    align-items: center;
    min-height: 3rem;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    font-size: 1.12rem;
    font-weight: 650;
    text-decoration: none;
  }

  .menu-links a[aria-current='page'] {
    color: var(--accent);
    box-shadow: inset 3px 0 0 var(--accent);
    padding-left: 0.85rem;
  }

  .menu-controls {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .menu-join {
    margin-left: auto;
  }

  @media (max-width: 63.99rem) {
    .nav-desktop {
      display: none;
    }

    .bar-mobile {
      display: flex;
    }

    .bar {
      padding-block: 0.55rem;
    }

    .brand-chip {
      width: 2.6rem;
      height: 2.6rem;
    }

    .brand-chip img {
      width: 2rem;
      height: 2rem;
    }

    .brand-name {
      font-size: 1.15rem;
    }
  }

  @media (max-width: 56rem) {
    .signalbar {
      display: none;
    }
  }

  /* Phones: the subtitle and the duplicate join action go first; the join
     button still lives inside the menu sheet. */
  @media (max-width: 30rem) {
    .brand-sub {
      display: none;
    }
  }

  /* Icon-only toggle on phones; the label stays for screen readers. */
  @media (max-width: 26rem) {
    .menu-toggle {
      padding-inline: 0.55rem;
    }

    .menu-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  @media (max-width: 21rem) {
    .join-link--compact {
      display: none;
    }
  }
</style>
