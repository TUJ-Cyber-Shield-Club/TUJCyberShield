---
// Body of the 404 page, shared by the flat /404.html the host serves and the
// per-locale /<code>/404/ pages, so the two can't drift apart.
import { Image } from 'astro:assets';
import shield from '../assets/logo-shield.png';
import { withBase } from '../utils/articles';
import { DEFAULT_LOCALE, type LocaleCode } from '../i18n/config';
import { localePath, useTranslations } from '../i18n/utils';

interface Props {
  lang?: LocaleCode;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
---

<div class="lost">
  {/* The fault code, with the club shield standing in for the zero. The
      digits are decoration; the heading below says it in words. */}
  <p class="err-code" aria-hidden="true">
    <span class="digit">4</span>
    <span class="lost-mark corner-frame">
      <Image src={shield} alt="" width="120" height="120" loading="eager" />
    </span>
    <span class="digit">4</span>
  </p>
  <h1>{t('notFound.h1')}</h1>
  <p class="lost-body">{t('notFound.body')}</p>
  <div class="cta">
    <a class="button" href={withBase(localePath(lang, '/'))}>{t('notFound.home')}</a>
    <a class="button button--ghost" href={withBase(localePath(lang, '/articles/'))}>
      {t('notFound.browse')}
    </a>
  </div>
</div>

<style>
  .lost {
    text-align: center;
    max-width: 34rem;
    margin-inline: auto;
    padding-block: clamp(2rem, 8vw, 5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
  }

  .err-code {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1rem);
    margin-bottom: 1rem;
  }

  .digit {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(5rem, 16vw, 8.5rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px var(--control-border);
  }

  .lost-mark {
    display: grid;
    place-items: center;
    padding: clamp(0.6rem, 2vw, 1rem);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: var(--edge-highlight), var(--shadow);
  }

  .lost-mark img {
    width: clamp(4.5rem, 14vw, 7.5rem);
    height: auto;
  }

  h1 {
    font-size: clamp(1.8rem, 5vw, 2.5rem);
  }

  .lost-body {
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 1.08rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.75rem;
  }
</style>
