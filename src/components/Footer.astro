---
import { withBase } from '../utils/articles';

const year = new Date().getFullYear();
const joinForm =
  'https://docs.google.com/forms/d/e/1FAIpQLSf8e37fWWAWD6axVy3mzr_sbEWz8ce-pZ0NZT-cZfEaTNVqkA/viewform?usp=header';
---

<footer>
  <div class="wrap">
    <div class="cols">
      <div class="brand-col">
        <p class="kick" aria-hidden="true">Cyber Shield</p>
        <p class="blurb">
          A student publication from the TUJ Cyber Shield Club: plain-language digital safety for
          everyday students, one issue a month.
        </p>
      </div>
      <nav aria-label="Footer">
        <p class="nav-label">Explore</p>
        <ul>
          <li><a href={withBase('/articles/')}>Articles</a></li>
          <li><a href={withBase('/issues/')}>Issues</a></li>
          <li><a href={withBase('/team/')}>Meet the team</a></li>
          <li><a href={withBase('/about/')}>About the club</a></li>
        </ul>
      </nav>
      <div class="contact-col">
        <p class="nav-label">Get involved</p>
        <ul>
          <li>
            <a href="https://www.instagram.com/tuj_cyber_shield_club/" target="_blank" rel="noopener"
              >@tuj_cyber_shield_club</a
            >
          </li>
          <li><a href={joinForm} target="_blank" rel="noopener">Join the club</a></li>
        </ul>
      </div>
    </div>

    <p class="marquee" aria-hidden="true">CYBER&nbsp;SHIELD</p>

    <p class="fine databar">
      <span>© {year} TUJ Cyber Shield Club</span>
      <span>Written by students, for students</span>
      <span>End of transmission</span>
    </p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    background:
      linear-gradient(180deg, transparent, var(--accent-soft) 180%),
      var(--bg-raised);
    padding-block: 3rem 1.75rem;
    margin-top: 4.5rem;
    overflow: hidden;
  }

  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(2, minmax(8.5rem, auto));
    gap: 2rem 4rem;
  }

  .blurb {
    max-width: 30rem;
    margin-top: 1rem;
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 1.02rem;
    line-height: 1.65;
  }

  .nav-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.95rem;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a,
  .contact-col a {
    color: var(--text);
    font-weight: 600;
    font-size: 0.93rem;
    text-decoration: none;
  }

  nav a:hover,
  .contact-col a:hover {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  /* The colophon: an enormous hollow wordmark, cropped by the page edge. */
  .marquee {
    margin-top: 2.75rem;
    margin-bottom: 1.5rem;
    font-weight: 850;
    font-size: clamp(3.4rem, 11.5vw, 9.5rem);
    line-height: 0.82;
    letter-spacing: 0.015em;
    text-align: center;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--line-strong);
    opacity: 0.5;
    user-select: none;
  }

  .fine {
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
    justify-content: center;
    text-align: center;
  }

  @media (max-width: 48rem) {
    .cols {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .marquee {
      text-align: left;
    }
  }
</style>
