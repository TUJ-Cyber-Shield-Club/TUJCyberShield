---
import { withBase } from '../utils/articles';
import { DEFAULT_LOCALE, type LocaleCode } from '../i18n/config';
import { localePath, useTranslations } from '../i18n/utils';

interface Props {
  lang?: LocaleCode;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const L = (path: string) => withBase(localePath(lang, path));

const year = new Date().getFullYear();
const joinForm =
  'https://docs.google.com/forms/d/e/1FAIpQLSf8e37fWWAWD6axVy3mzr_sbEWz8ce-pZ0NZT-cZfEaTNVqkA/viewform?usp=header';
---

<footer>
  <div class="wrap">
    <div class="cols">
      <div class="brand-col">
        <p class="kick" aria-hidden="true">Cyber Shield</p>
        <p class="blurb">{t('footer.blurb')}</p>
      </div>
      <nav aria-label={t('footer.aria')}>
        <p class="nav-label">{t('footer.explore')}</p>
        <ul>
          <li><a href={L('/articles/')}>{t('nav.articles')}</a></li>
          <li><a href={L('/issues/')}>{t('nav.issues')}</a></li>
          <li><a href={L('/team/')}>{t('footer.meetTeam')}</a></li>
          <li><a href={L('/about/')}>{t('footer.aboutClub')}</a></li>
        </ul>
      </nav>
      <div class="contact-col">
        <p class="nav-label">{t('footer.getInvolved')}</p>
        <ul>
          <li>
            <a href="https://www.instagram.com/tuj_cyber_shield_club/" target="_blank" rel="noopener"
              >@tuj_cyber_shield_club</a
            >
          </li>
          <li><a href={joinForm} target="_blank" rel="noopener">{t('header.join')}</a></li>
        </ul>
      </div>
    </div>

    <p class="marquee" aria-hidden="true">CYBER&nbsp;SHIELD</p>

    <p class="fine databar">
      <span>{t('footer.copyright', { year })}</span>
      <span>{t('footer.byStudents')}</span>
      <span>{t('footer.end')}</span>
    </p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    background:
      linear-gradient(180deg, transparent, var(--accent-soft) 180%),
      var(--bg-raised);
    padding-block: 3rem 1.75rem;
    margin-top: 4.5rem;
    overflow: hidden;
  }

  /* Size the hollow wordmark from this box so it always fits the padded width. */
  .wrap {
    container-type: inline-size;
    container-name: footer;
  }

  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(2, minmax(8.5rem, auto));
    gap: 2rem 4rem;
  }

  .blurb {
    max-width: 30rem;
    margin-top: 1rem;
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 1.02rem;
    line-height: 1.65;
  }

  .nav-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.95rem;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a,
  .contact-col a {
    color: var(--text);
    font-weight: 600;
    font-size: 0.93rem;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  nav a:hover,
  .contact-col a:hover {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  /* Hollow colophon wordmark — always centered, always fully on-screen.
     "CYBER SHIELD" is ~7.8em wide in Libre Franklin 850; divide cqw by 9.5
     so glyph strokes never kiss the padded edge on phones. */
  .marquee {
    margin-top: 2.75rem;
    margin-bottom: 1.5rem;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    padding-inline: 0.1em;
    font-weight: 850;
    font-size: clamp(1.5rem, calc(100cqw / 9.5), 9.5rem);
    line-height: 1;
    letter-spacing: 0.01em;
    text-align: center;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1.25px var(--line-strong);
    paint-order: stroke fill;
    opacity: 0.5;
    user-select: none;
  }

  .fine {
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
    justify-content: center;
    text-align: center;
  }

  @media (max-width: 48rem) {
    .cols {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .fine {
      flex-direction: column;
      gap: 0.35rem;
    }

    .fine > * + *::before {
      content: none;
    }
  }
</style>
