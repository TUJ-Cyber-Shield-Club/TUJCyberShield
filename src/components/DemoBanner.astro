---
import { DEFAULT_LOCALE, type LocaleCode } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

interface Props {
  /** Tailors the wording to where the banner appears. */
  context?: 'article' | 'issue' | 'list';
  lang?: LocaleCode;
}

const { context = 'article', lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);

const message = t(`demo.${context}` as 'demo.article' | 'demo.issue' | 'demo.list');
---

<aside class="demo-banner" role="note" aria-label={t('demo.aria')}>
  <span class="demo-badge">{t('demo.badge')}</span>
  <p>{message}</p>
</aside>

<style>
  .demo-banner {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-block: 1.5rem 1.75rem;
    padding: 0.75rem 1rem;
    /* keep in sync with --warn in tokens.css */
    border: 1px dashed rgb(172 77 13 / 0.55);
    border-radius: 6px;
    background: var(--warn-soft);
    color: var(--text);
    font-family: var(--font-display);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .demo-badge {
    flex: none;
    padding: 0.26rem 0.6rem;
    border-radius: 3px;
    background: var(--warn);
    color: #fff6ee;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* At the very top of an article it sits under the main padding instead. */
  :global(.reading-progress) + .demo-banner {
    margin-top: 0;
  }

  .demo-banner p {
    margin: 0;
  }
</style>
