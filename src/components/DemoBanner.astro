---
interface Props {
  /** Tailors the wording to where the banner appears. */
  context?: 'article' | 'issue' | 'list';
}

const { context = 'article' } = Astro.props;

const message = {
  article:
    'This is a demo article: a sample template that shows the layout and voice of the site, not a real Cyber Shield publication.',
  issue:
    'This is a demo issue: the articles below are sample templates, not real Cyber Shield publications.',
  list: 'The articles shown here are demo templates, not real Cyber Shield publications yet.',
}[context];
---

<aside class="demo-banner" role="note" aria-label="Demo content notice">
  <span class="demo-badge">Demo</span>
  <p>{message}</p>
</aside>

<style>
  .demo-banner {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.75rem;
    padding: 0.75rem 1rem;
    border: 1px dashed rgb(179 80 14 / 0.55);
    border-radius: 6px;
    background: var(--warn-soft);
    color: var(--text);
    font-family: var(--font-display);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .demo-badge {
    flex: none;
    padding: 0.26rem 0.6rem;
    border-radius: 3px;
    background: var(--warn);
    color: #fff6ee;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    clip-path: polygon(0 0, calc(100% - 6px) 0, 100% 6px, 100% 100%, 0 100%);
  }

  .demo-banner p {
    margin: 0;
  }
</style>
