---
import { DEFAULT_LOCALE, type LocaleCode } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: LocaleCode;
}

import { withBase } from '../utils/articles';

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);

// Pagefind's UI bundle is generated into dist/pagefind/ by the postbuild step,
// so it only exists after `npm run build`. The loader below fails quietly in
// `astro dev`, where the search box shows a short explanation instead.
const pagefindBase = withBase('/pagefind');
---

<div class="search-block">
  <label class="visually-hidden" for="search-box-input" id="search-label">{t('search.kick')}</label>
  <div
    id="search"
    data-base={pagefindBase}
    data-placeholder={t('search.placeholder')}
    data-build-only={t('search.buildOnly')}
  >
  </div>
  <noscript>
    <p class="meta">{t('search.noJs')}</p>
  </noscript>
</div>

<script>
  const container = document.getElementById('search');
  if (container) {
    const base = container.dataset.base;
    const script = document.createElement('script');
    script.src = `${base}/pagefind-ui.js`;
    script.onload = () => {
      // @ts-expect-error PagefindUI is provided by the script loaded above
      new PagefindUI({
        element: '#search',
        showImages: false,
        showSubResults: true,
        translations: { placeholder: container.dataset.placeholder ?? '' },
      });
      const input = container.querySelector('input');
      if (input) input.id = 'search-box-input';
    };
    script.onerror = () => {
      // Escaped by textContent rather than innerHTML: the string is ours, but
      // it now varies per locale, so treat it as data.
      const note = document.createElement('p');
      note.className = 'meta';
      note.textContent = container.dataset.buildOnly ?? '';
      container.replaceChildren(note);
    };
    document.head.append(script);

    const css = document.createElement('link');
    css.rel = 'stylesheet';
    css.href = `${base}/pagefind-ui.css`;
    document.head.append(css);
  }
</script>

<style is:global>
  .search-block {
    width: 100%;
  }

  #search {
    --pagefind-ui-scale: 0.92;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--bg-raised);
    --pagefind-ui-border: var(--line-strong);
    --pagefind-ui-tag: var(--bg-inset);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-font: var(--font-display);
  }

  /* Hold the input's height (Pagefind draws it at 64px × the UI scale)
     before the script injects it, so the filters below don't jump down. */
  html.js #search {
    min-height: calc(64px * 0.92);
  }

  #search .pagefind-ui__search-input {
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  /* iOS Safari zooms the whole page when a focused input is under 16px. */
  @media (pointer: coarse) {
    #search .pagefind-ui__search-input {
      font-size: 16px;
    }
  }

  #search .pagefind-ui__result-link {
    color: var(--accent);
    font-weight: 650;
  }

  #search .pagefind-ui__result-excerpt mark {
    background: var(--accent);
    color: var(--accent-contrast);
    border-radius: 2px;
    padding-inline: 0.1em;
  }
</style>
