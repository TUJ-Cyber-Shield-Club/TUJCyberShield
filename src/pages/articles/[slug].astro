---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import DemoBanner from '../../components/DemoBanner.astro';
import {
  formatDate,
  getPublishedArticles,
  issueLabel,
  readingTime,
  withBase,
  type Article,
} from '../../utils/articles';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((article, index) => ({
    params: { slug: article.id },
    props: {
      article,
      // articles are sorted newest first
      newer: articles[index - 1] ?? null,
      older: articles[index + 1] ?? null,
      sameIssue: articles.filter(
        (other) => other.data.issue === article.data.issue && other.id !== article.id
      ),
    },
  }));
}

interface Props {
  article: Article;
  newer: Article | null;
  older: Article | null;
  sameIssue: Article[];
}

const { article, newer, older, sameIssue } = Astro.props;
const { title, description, pubDate, authors, tags, issue, coverImage, coverAlt } = article.data;
const { Content } = await render(article);
const minutes = readingTime(article.body);

const ogImage = coverImage
  ? new URL((await getImage({ src: coverImage, width: 1200 })).src, Astro.site).href
  : undefined;
---

<Base title={`${title} · Cyber Shield`} description={description} ogType="article" ogImage={ogImage}>
  <div class="reading-progress" hidden aria-hidden="true"><span></span></div>

  {article.data.demo && <DemoBanner context="article" />}

  <article data-pagefind-body>
    <header class="article-head">
      <p class="databar" data-pagefind-ignore>
        <a class="issue-link" href={withBase(`/issues/${issue}/`)}
          >{issueLabel(issue)} issue</a
        >
        <span><time datetime={pubDate.toISOString().slice(0, 10)}>{formatDate(pubDate)}</time></span>
        <span>{minutes} min read</span>
        <span><b>{authors.join(', ')}</b></span>
      </p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {
        tags.length > 0 && (
          <ul class="chips" aria-label="Tags" data-pagefind-ignore>
            {tags.map((tag) => (
              <li style="display:contents">
                <a class="chip" href={withBase(`/tags/${tag}/`)} data-pagefind-filter="topic">
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      coverImage && coverAlt && (
        <div class="cover corner-frame">
          <Image src={coverImage} alt={coverAlt} width="1400" loading="eager" />
        </div>
      )
    }

    <div class="prose body-text">
      <Content />
    </div>

    <p class="endmark databar" aria-hidden="true"><span>◼ ◼ ◼</span><span>End of transmission</span></p>
  </article>

  {
    sameIssue.length > 0 && (
      <aside class="section related" aria-labelledby="related-heading">
        <h2 class="kick kick--lead" id="related-heading">
          More from the {issueLabel(issue)} issue
        </h2>
        <ul>
          {sameIssue.map((other) => (
            <li>
              <a href={withBase(`/articles/${other.id}/`)}>{other.data.title}</a>
              <span class="meta">: {other.data.description}</span>
            </li>
          ))}
        </ul>
      </aside>
    )
  }

  <nav class="section pager" aria-label="Article navigation">
    {
      older ? (
        <a class="pager-link" href={withBase(`/articles/${older.id}/`)} rel="prev">
          <span class="pager-dir">← Older</span>
          <span class="pager-title">{older.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      newer ? (
        <a class="pager-link pager-next" href={withBase(`/articles/${newer.id}/`)} rel="next">
          <span class="pager-dir">Newer →</span>
          <span class="pager-title">{newer.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</Base>

<script>
  // Horizontal reading-progress scan line. Decorative and JS-only, so it
  // ships hidden and is revealed here; the article reads fine without it.
  const wrap = document.querySelector<HTMLElement>('.reading-progress');
  const fill = wrap?.querySelector<HTMLElement>('span');
  const article = document.querySelector<HTMLElement>('article');

  if (wrap && fill && article) {
    wrap.hidden = false;
    let ticking = false;

    const update = () => {
      ticking = false;
      const top = article.getBoundingClientRect().top + window.scrollY;
      const scrollable = article.offsetHeight - window.innerHeight;
      const ratio = scrollable > 0 ? (window.scrollY - top) / scrollable : 1;
      fill.style.width = `${Math.min(100, Math.max(0, ratio * 100))}%`;
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 60;
    background: var(--line);
  }

  .reading-progress > span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
  }

  article {
    max-width: 46rem;
    margin-inline: auto;
  }

  .issue-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }

  .issue-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .article-head h1 {
    font-size: clamp(2.1rem, 5.4vw, 3.1rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-top: 1.35rem;
  }

  .lede {
    margin-top: 1.05rem;
    font-family: var(--font-body);
    font-size: 1.22rem;
    line-height: 1.62;
    color: var(--text-muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  .cover {
    margin-top: 2rem;
    padding: 0.5rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg-raised);
  }

  .cover img {
    border-radius: 4px;
  }

  .prose {
    margin-top: 2.5rem;
  }

  /* the broadsheet drop cap — only on the opening paragraph of the body */
  .body-text.prose > p:first-of-type::first-letter {
    float: left;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 3.4em;
    line-height: 0.82;
    padding: 0.06em 0.12em 0 0;
    color: var(--accent);
  }

  .endmark {
    justify-content: center;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    letter-spacing: 0.2em;
  }

  .endmark span:first-child {
    color: var(--accent);
    letter-spacing: 0.35em;
  }

  .related,
  .pager {
    max-width: 46rem;
    margin-inline: auto;
    margin-top: clamp(3rem, 8vw, 4.5rem);
  }

  .related ul {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .related li {
    padding-block: 0.85rem;
    border-top: 1px solid var(--line);
  }

  .related a {
    font-weight: 650;
    text-decoration: none;
  }

  .related a:hover {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg-raised);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .pager-link:hover {
    border-color: var(--accent-line);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .pager-dir {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .pager-title {
    font-weight: 650;
    line-height: 1.25;
    color: var(--text);
  }

  .pager-link:hover .pager-title {
    color: var(--accent-strong);
  }

  .pager-next {
    text-align: right;
    align-items: flex-end;
  }

  @media (max-width: 34rem) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager-next {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>
