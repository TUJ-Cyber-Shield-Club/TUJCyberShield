---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import DemoBanner from '../../components/DemoBanner.astro';
import { collectIssues, getPublishedArticles, issueLabel, withBase } from '../../utils/articles';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return collectIssues(articles).map((issue) => ({
    params: { issue },
    props: { inIssue: articles.filter((a) => a.data.issue === issue) },
  }));
}

const { issue } = Astro.params;
const { inIssue } = Astro.props;
const label = issueLabel(issue!);
const hasDemo = inIssue.some((a) => a.data.demo);
const [lead, ...rest] = inIssue;
---

<Base
  title={`${label} issue · Cyber Shield`}
  description={`All ${inIssue.length} articles from the ${label} issue of Cyber Shield, TUJ's plain-language digital safety newsletter.`}
>
  <header class="masthead reveal">
    <p class="kick kick--center">Cyber Shield · Issue {issue}</p>
    <h1>The {label} issue</h1>
    <p class="databar masthead-meta">
      <span>
        <b>{inIssue.length}</b> article{inIssue.length === 1 ? '' : 's'}
      </span>
      <span>Researched, written, and edited by club members</span>
    </p>
  </header>

  {hasDemo && <DemoBanner context="issue" />}

  <ul class="card-grid reveal">
    {lead && <ArticleCard article={lead} headingLevel="h2" feature eager />}
    {rest.map((article) => <ArticleCard article={article} headingLevel="h2" />)}
  </ul>

  <p class="back databar">
    <a href={withBase('/issues/')}>← All issues</a>
  </p>
</Base>

<style>
  .masthead {
    text-align: center;
    max-width: 44rem;
    margin: 0 auto 3rem;
  }

  .masthead h1 {
    font-size: clamp(2.3rem, 5.6vw, 3.5rem);
    margin-top: 1.15rem;
  }

  .masthead-meta {
    justify-content: center;
    margin-top: 1rem;
  }

  .back {
    margin-top: 2.5rem;
  }

  .back a {
    font-weight: 600;
    text-decoration: none;
  }

  .back a:hover {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }
</style>
