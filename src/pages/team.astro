---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SocialIcons from '../components/SocialIcons.astro';
import { team } from '../data/team';
import { withBase } from '../utils/articles';

const joinForm =
  'https://docs.google.com/forms/d/e/1FAIpQLSf8e37fWWAWD6axVy3mzr_sbEWz8ce-pZ0NZT-cZfEaTNVqkA/viewform?usp=header';
---

<Base
  title="Meet the team · Cyber Shield"
  description="The students behind Cyber Shield: the writers, editors, and organizers who research and publish TUJ's monthly digital-safety newsletter."
>
  <header class="masthead reveal">
    <p class="kick kick--center">The people behind the publication</p>
    <h1>Meet the team</h1>
    <p class="lede">
      Cyber Shield is written and edited entirely by students. Here's who researches the threats,
      writes the guides, and keeps each issue on schedule.
    </p>
  </header>

  <ul class="team-grid">
    {
      team.map((member, i) => (
        <li class="member reveal" style={`--reveal-delay: ${i * 90}ms`}>
          <div class="avatar-frame">
            <Image
              class="avatar"
              src={member.avatar}
              alt={`Photo of ${member.name}`}
              width="240"
              height="240"
              fit="cover"
              loading="lazy"
            />
          </div>
          <div class="member-body">
            <h2>{member.name}</h2>
            <p class="role">{member.role}</p>
            <p class="bio">{member.bio}</p>
            <SocialIcons links={member.links} name={member.name} />
          </div>
        </li>
      ))
    }
  </ul>

  <aside class="join corner-frame reveal">
    <p class="kick kick--center">Want to join?</p>
    <h2>There's room for you on this team.</h2>
    <p class="join-copy">
      No experience needed, just curiosity and a willingness to help people stay safe online.
      Writers, researchers, editors, and organizers all welcome.
    </p>
    <div class="cta">
      <a class="button" href={joinForm} target="_blank" rel="noopener">Join here</a>
      <a class="button button--ghost" href={withBase('/about/')}>About the club</a>
    </div>
  </aside>
</Base>

<style>
  .masthead {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto 3.25rem;
  }

  .masthead h1 {
    font-size: clamp(2.3rem, 5.6vw, 3.5rem);
    margin-top: 1.15rem;
  }

  .lede {
    margin-top: 1rem;
    font-family: var(--font-body);
    font-size: 1.14rem;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .team-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.4rem;
    grid-template-columns: repeat(auto-fill, minmax(min(22rem, 100%), 1fr));
  }

  .member {
    display: flex;
    gap: 1.2rem;
    padding: 1.5rem;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 6px;
    transition: border-color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .member:hover {
    border-color: var(--accent-line);
    box-shadow: var(--shadow-lift);
    transform: translateY(-3px);
  }

  .avatar-frame {
    flex: 0 0 auto;
    padding: 0.35rem;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--bg-inset);
    align-self: flex-start;
    transition: border-color var(--dur) var(--ease-out);
  }

  .member:hover .avatar-frame {
    border-color: var(--accent);
  }

  .avatar {
    width: 4.4rem;
    height: 4.4rem;
    border-radius: 5px;
    object-fit: cover;
  }

  .member-body h2 {
    font-size: 1.22rem;
  }

  .role {
    font-family: var(--font-mono);
    color: var(--accent);
    font-weight: 550;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-top: 0.3rem;
  }

  .bio {
    margin-top: 0.7rem;
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.62;
  }

  .join {
    text-align: center;
    max-width: 42rem;
    margin: clamp(3.5rem, 9vw, 5rem) auto 0;
    padding: clamp(2rem, 5vw, 3rem) clamp(1.5rem, 4vw, 2.5rem);
    background:
      linear-gradient(135deg, var(--accent-soft), transparent 55%),
      var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .join h2 {
    font-size: clamp(1.5rem, 4vw, 2.1rem);
    margin-top: 0.8rem;
  }

  .join-copy {
    margin-top: 0.85rem;
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 1.08rem;
    max-width: 34rem;
    margin-inline: auto;
  }

  .cta {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1.75rem;
  }

  @media (max-width: 34rem) {
    .member {
      flex-direction: column;
    }
  }
</style>
