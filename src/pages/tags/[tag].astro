---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import DemoBanner from '../../components/DemoBanner.astro';
import { collectTags, getPublishedArticles, withBase } from '../../utils/articles';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return collectTags(articles).map((tag) => ({
    params: { tag },
    props: { tagged: articles.filter((a) => a.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { tagged } = Astro.props;
const allTags = collectTags(await getPublishedArticles());
const hasDemo = tagged.some((a) => a.data.demo);
---

<Base
  title={`Articles tagged “${tag}” · Cyber Shield`}
  description={`All Cyber Shield articles about ${tag}: practical, plain-language advice for students.`}
>
  <header class="masthead">
    <p class="kick">Topic file</p>
    <h1><span class="hash" aria-hidden="true">#</span>{tag}</h1>
    <p class="databar masthead-meta">
      <span>
        <b>{tagged.length}</b> article{tagged.length === 1 ? '' : 's'} on this topic
      </span>
    </p>
  </header>

  <nav class="tag-filter" aria-label="Filter by tag">
    <ul class="chips">
      <li style="display:contents">
        <a class="chip" href={withBase('/articles/')}>all</a>
      </li>
      {
        allTags.map((other) => (
          <li style="display:contents">
            <a
              class="chip"
              href={withBase(`/tags/${other}/`)}
              aria-current={other === tag ? 'true' : undefined}
            >
              {other}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {hasDemo && <DemoBanner context="list" />}

  <ul class="card-grid reveal">
    {tagged.map((article) => <ArticleCard article={article} headingLevel="h2" />)}
  </ul>
</Base>

<style>
  h1 {
    margin-top: 1rem;
    font-size: clamp(2.3rem, 5.4vw, 3.4rem);
    text-transform: capitalize;
  }

  .hash {
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.72em;
    margin-right: 0.08em;
  }

  .masthead-meta {
    margin-top: 1rem;
  }

  .tag-filter {
    margin-block: 1.75rem 2.25rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
