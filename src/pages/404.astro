---
// The host serves this single file for every unmatched path, including ones
// under a locale prefix, so it cannot itself be emitted per language. It
// renders the default locale — the right fallback with no JS — and hands off
// to the fully translated /<locale>/404/ when the missed URL was localized.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import shield from '../assets/logo-shield.png';
import { withBase } from '../utils/articles';
import { DEFAULT_LOCALE, PREFIXED_LOCALES } from '../i18n/config';
import { localePath, useTranslations } from '../i18n/utils';

const t = useTranslations(DEFAULT_LOCALE);
---

<Base langTarget="/" title={t('notFound.title')} description={t('notFound.description')}>
  <div class="lost" data-prefixed-locales={PREFIXED_LOCALES.join(',')}>
    <p class="err-code" aria-hidden="true">404</p>
    <div class="lost-mark corner-frame">
      <Image src={shield} alt="" width="120" height="120" loading="eager" />
    </div>
    <p class="kick kick--center">{t('notFound.kick')}</p>
    <h1>{t('notFound.h1')}</h1>
    <p class="meta">{t('notFound.body')}</p>
    <div class="cta">
      <a class="button" href={withBase(localePath(DEFAULT_LOCALE, '/'))}>{t('notFound.home')}</a>
      <a class="button button--ghost" href={withBase(localePath(DEFAULT_LOCALE, '/articles/'))}>
        {t('notFound.browse')}
      </a>
    </div>
  </div>
</Base>

<script>
  // If the URL that 404'd was localized, send the reader to that language's
  // own 404 page, which is fully translated including header and footer.
  const root = document.querySelector<HTMLElement>('[data-prefixed-locales]');
  const locales = (root?.dataset.prefixedLocales ?? '').split(',').filter(Boolean);
  const first = location.pathname.split('/').filter(Boolean)[0] ?? '';
  if (locales.includes(first)) {
    // replace() so Back returns to wherever they came from, not this page.
    location.replace(`/${first}/404/`);
  }
</script>

<style>
  .lost {
    text-align: center;
    max-width: 34rem;
    margin-inline: auto;
    padding-block: clamp(2rem, 8vw, 5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
  }

  /* the fault code: a huge hollow readout behind the shield */
  .err-code {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(5rem, 16vw, 8.5rem);
    line-height: 0.85;
    letter-spacing: 0.02em;
    color: transparent;
    -webkit-text-stroke: 2px var(--line-strong);
    opacity: 0.6;
    margin-bottom: -2.5rem;
  }

  .lost-mark {
    position: relative;
    padding: 1rem;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  h1 {
    font-size: clamp(1.8rem, 5vw, 2.5rem);
  }

  .cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.75rem;
  }
</style>
