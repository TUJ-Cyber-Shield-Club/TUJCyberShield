---
import { LOCALE_CODES } from '../../../i18n/config';
import { langParam, useTranslations } from '../../../i18n/utils';
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import ArticleCover from '../../../components/ArticleCover.astro';
import { localized, memberForAuthor, memberSlug } from '../../../data/team';
import {
  articleSlug,
  getPublishedArticles,
  readingTime,
  withBase,
  type Article,
} from '../../../utils/articles';
import { formatDateIn, issueLabelIn, localePath, tagLabel } from '../../../i18n/utils';

const { lang } = Astro.props;
const t = useTranslations(lang);


interface Props {
  article: Article;
  newer: Article | null;
  older: Article | null;
  sameIssue: Article[];
}

const { article, newer, older, sameIssue } = Astro.props;
const { title, description, showDescription, pubDate, authors, tags, issue, coverImage, coverAlt } = article.data;
const { Content } = await render(article);
const minutes = readingTime(article.body);

// Bylines that match a team member link to their popup on the team page.
const credits = authors.map((name) => {
  const member = memberForAuthor(name);
  return {
    name,
    member,
    href: member && withBase(localePath(lang, `/team/#member-${memberSlug(member)}`)),
  };
});

// Share image: the author's cover if there is one, else the generated cover
// rasterized at build time by src/pages/og/[slug].png.ts.
const ogImage = coverImage
  ? new URL((await getImage({ src: coverImage, width: 1200 })).src, Astro.site).href
  : new URL(withBase(`/og/${articleSlug(article)}.png`), Astro.site).href;

export async function getStaticPaths() {
  // Articles differ per locale, so each language is queried separately rather
  // than fanning one English list across every prefix.
  const out = [];
  for (const code of LOCALE_CODES) {
    const articles = await getPublishedArticles(code);
    // Lists follow each issue's chosen order, but the pager's "Older/Newer"
    // must follow publication dates to stay truthful.
    const byDate = [...articles].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    byDate.forEach((article, index) => {
      out.push({
        params: { lang: langParam(code), slug: articleSlug(article) },
        props: {
          lang: code,
          article,
          // articles are sorted newest first
          newer: byDate[index - 1] ?? null,
          older: byDate[index + 1] ?? null,
          sameIssue: articles.filter(
            (other) => other.data.issue === article.data.issue && other.id !== article.id
          ),
        },
      });
    });
  }
  return out;
}
---

<Base lang={lang} title={`${title} · Cyber Shield`} description={description} ogType="article" ogImage={ogImage}>
  <div class="reading-progress" hidden aria-hidden="true"><span></span></div>

  <article data-pagefind-body>
    <header class="article-head">
      <p class="databar" data-pagefind-ignore>
        <a class="issue-link" href={withBase(localePath(lang, `/issues/${issue}/`))}
          >{t('article.issueLink', { issue: issueLabelIn(lang, issue) })}</a
        >
        <span><time datetime={pubDate.toISOString().slice(0, 10)}>{formatDateIn(lang, pubDate)}</time></span>
        <span>{t('card.minRead', { count: minutes })}</span>
        <span>
          {
            credits.map((credit, i) => (
              <>
                {i > 0 && ', '}
                {credit.href ? (
                  <a class="byline-link" href={credit.href}>
                    <b>{credit.name}</b>
                  </a>
                ) : (
                  <b>{credit.name}</b>
                )}
              </>
            ))
          }
        </span>
      </p>
      <h1>{title}</h1>
      {showDescription && <p class="lede">{description}</p>}
      {
        tags.length > 0 && (
          <ul class="chips" aria-label={t('article.tags')} data-pagefind-ignore>
            {tags.map((tag) => (
              <li style="display:contents">
                <a class="chip" href={withBase(localePath(lang, `/tags/${tag}/`))} data-pagefind-filter="topic">
                  {tagLabel(lang, tag)}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="cover corner-frame">
      {
        coverImage && coverAlt ? (
          <Image src={coverImage} alt={coverAlt} width="1400" loading="eager" />
        ) : (
          <ArticleCover article={article} lang={lang} class="cover-art" />
        )
      }
    </div>

    <div class="prose body-text">
      <Content />
    </div>

    <section class="credits" aria-labelledby="credits-heading" data-pagefind-ignore>
      <h2 class="kick kick--lead" id="credits-heading">{t('article.writtenBy')}</h2>
      <ul>
        {
          credits.map(({ name, member, href }) =>
            member && href ? (
              <li>
                <a class="credit" href={href} aria-label={t('article.profileOf', { name })}>
                  <Image
                    class="credit-avatar"
                    src={member.avatar}
                    alt=""
                    width="128"
                    height="128"
                    fit="cover"
                    loading="lazy"
                  />
                  <span class="credit-text">
                    <span class="credit-name">{name}</span>
                    <span class="credit-role">{localized(member.role, lang)}</span>
                    <span class="credit-cta">{t('article.viewProfile')} →</span>
                  </span>
                </a>
              </li>
            ) : (
              <li>
                <div class="credit credit--plain">
                  <span class="credit-avatar credit-initial" aria-hidden="true">{name.trim().charAt(0)}</span>
                  <span class="credit-text">
                    <span class="credit-name">{name}</span>
                  </span>
                </div>
              </li>
            )
          )
        }
      </ul>
    </section>
  </article>

  {
    sameIssue.length > 0 && (
      <aside class="section related" aria-labelledby="related-heading">
        <h2 class="kick kick--lead" id="related-heading">
          {t('article.moreFrom', { issue: issueLabelIn(lang, issue) })}
        </h2>
        <ul>
          {sameIssue.map((other) => (
            <li>
              <a href={withBase(localePath(lang, `/articles/${articleSlug(other)}/`))}>{other.data.title}</a>
              <span class="meta">: {other.data.description}</span>
            </li>
          ))}
        </ul>
      </aside>
    )
  }

  {/* A lone neighbour spans the full row instead of leaving an empty half. */}
  <nav class:list={['section', 'pager', !(older && newer) && 'pager--single']} aria-label={t('article.navAria')}>
    {
      older && (
        <a class="pager-link" href={withBase(localePath(lang, `/articles/${articleSlug(older)}/`))} rel="prev">
          <span class="pager-dir">← {t('article.older')}</span>
          <span class="pager-title">{older.data.title}</span>
        </a>
      )
    }
    {
      newer && (
        <a class="pager-link pager-next" href={withBase(localePath(lang, `/articles/${articleSlug(newer)}/`))} rel="next">
          <span class="pager-dir">{t('article.newer')} →</span>
          <span class="pager-title">{newer.data.title}</span>
        </a>
      )
    }
  </nav>
</Base>

<script>
  // Horizontal reading-progress scan line. Decorative and JS-only, so it
  // ships hidden and is revealed here; the article reads fine without it.
  const wrap = document.querySelector<HTMLElement>('.reading-progress');
  const fill = wrap?.querySelector<HTMLElement>('span');
  const article = document.querySelector<HTMLElement>('article');

  if (wrap && fill && article) {
    wrap.hidden = false;
    let ticking = false;

    const update = () => {
      ticking = false;
      const top = article.getBoundingClientRect().top + window.scrollY;
      const scrollable = article.offsetHeight - window.innerHeight;
      const ratio = scrollable > 0 ? (window.scrollY - top) / scrollable : 1;
      fill.style.width = `${Math.min(100, Math.max(0, ratio * 100))}%`;
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 60;
    background: var(--line);
  }

  .reading-progress > span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
  }

  article {
    max-width: 46rem;
    margin-inline: auto;
  }

  .issue-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }

  .issue-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .article-head h1 {
    font-size: clamp(2.1rem, 5.4vw, 3.1rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-top: 1.35rem;
  }

  .lede {
    margin-top: 1.05rem;
    font-family: var(--font-body);
    font-size: 1.22rem;
    line-height: 1.62;
    color: var(--text-muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  .cover {
    margin-top: 2rem;
    padding: 0.5rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg-raised);
  }

  .cover img,
  .cover :global(.cover-art) {
    border-radius: 4px;
    overflow: hidden;
  }

  .cover :global(.cover-art svg) {
    aspect-ratio: 1200 / 630;
  }

  .prose {
    margin-top: 2.5rem;
  }

  /* the broadsheet drop cap — only on the opening paragraph of the body */
  .body-text.prose > p:first-of-type::first-letter {
    float: left;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 3.4em;
    line-height: 0.82;
    padding: 0.06em 0.12em 0 0;
    color: var(--accent);
  }

  .byline-link {
    color: inherit;
    text-decoration: none;
  }

  .byline-link:hover b {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .credits {
    margin-top: 3.5rem;
  }

  .credits ul {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fill, minmax(min(19rem, 100%), 1fr));
  }

  .credit {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg-raised);
    box-shadow: var(--edge-highlight), var(--shadow-rest);
    text-decoration: none;
    color: var(--text);
    transition: border-color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  a.credit:hover {
    border-color: var(--accent-line);
  }

  @media (hover: hover) and (pointer: fine) {
    a.credit:hover {
      box-shadow: var(--edge-highlight), var(--shadow);
      transform: translateY(-2px);
    }
  }

  .credit-avatar {
    flex: none;
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 50%;
    border: 1px solid var(--accent-line);
    object-fit: cover;
  }

  .credit-initial {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.4rem;
    color: var(--accent);
    background: var(--bg-inset);
  }

  .credit-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .credit-name {
    font-weight: 700;
    line-height: 1.25;
  }

  .credit-role {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .credit-cta {
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  a.credit:hover .credit-name {
    color: var(--accent-strong);
  }

  .related,
  .pager {
    max-width: 46rem;
    margin-inline: auto;
    margin-top: clamp(3rem, 8vw, 4.5rem);
  }

  .related ul {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .related li {
    padding-block: 0.85rem;
    border-top: 1px solid var(--line);
  }

  .related a {
    font-weight: 650;
    text-decoration: none;
  }

  .related a:hover {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .pager--single {
    grid-template-columns: 1fr;
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg-raised);
    box-shadow: var(--edge-highlight), var(--shadow-rest);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .pager-link:hover {
    border-color: var(--accent-line);
  }

  @media (hover: hover) and (pointer: fine) {
    .pager-link:hover {
      box-shadow: var(--edge-highlight), var(--shadow);
      transform: translateY(-2px);
    }
  }

  .pager-dir {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .pager-title {
    font-weight: 650;
    line-height: 1.25;
    color: var(--text);
  }

  .pager-link:hover .pager-title {
    color: var(--accent-strong);
  }

  .pager-next {
    text-align: right;
    align-items: flex-end;
  }

  @media (max-width: 34rem) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager-next {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>
