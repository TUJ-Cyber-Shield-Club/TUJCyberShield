---
import { localeStaticPaths, useTranslations } from '../../i18n/utils';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import DemoBanner from '../../components/DemoBanner.astro';
import shield from '../../assets/logo-shield.png';
import { collectIssues, collectTags, getPublishedArticles, withBase } from '../../utils/articles';
import { issueLabelIn, localePath } from '../../i18n/utils';

const { lang } = Astro.props;
const t = useTranslations(lang);

const articles = await getPublishedArticles(lang);
const latestIssue = articles[0]?.data.issue;
const latestIssueArticles = articles.filter((a) => a.data.issue === latestIssue);
const [coverStory, ...restOfIssue] = latestIssueArticles;
const earlier = articles.filter((a) => a.data.issue !== latestIssue).slice(0, 6);
const hasDemo = articles.some((a) => a.data.demo);
const issues = collectIssues(articles);
const tags = collectTags(articles);

export const getStaticPaths = localeStaticPaths;
---

<Base lang={lang} title={t('home.title')} description={t('home.description')}>
  <section class="hero">
    <div class="hero-text">
      <p class="kick">{t('home.kick')}</p>
      <h1>
        {t('home.h1.a')}<br />
        <em>{t('home.h1.b')}</em>
      </h1>
      <p class="lede">{t('home.lede')}</p>
      <div class="cta">
        {
          latestIssue && (
            <a class="button" href={withBase(localePath(lang, `/issues/${latestIssue}/`))}>
              {t('home.cta.latest')} <span class="button-arrow" aria-hidden="true">→</span>
            </a>
          )
        }
        <a class="button button--ghost" href={withBase(localePath(lang, '/about/'))}>
          {t('home.cta.about')}
        </a>
      </div>
    </div>

    <div class="hero-crest" aria-hidden="true">
      <div class="crest-frame corner-frame">
        <Image
          src={shield}
          alt=""
          width="400"
          height="400"
          loading="eager"
        />
      </div>
      <p class="databar crest-bar">
        <span>{t('home.crest.monthly')}</span>
        <span>{t('home.crest.plain')}</span>
        <span>{t('home.crest.student')}</span>
      </p>
    </div>
  </section>

  <div class="ledger reveal" role="list">
    <p role="listitem"><b>{articles.length}</b> {t('home.ledger.briefings')}</p>
    <p role="listitem">
      <b>{issues.length}</b>{' '}
      {issues.length === 1 ? t('home.ledger.issues_one') : t('home.ledger.issues_other')}
    </p>
    <p role="listitem"><b>{tags.length}</b> {t('home.ledger.topics')}</p>
    <p role="listitem"><b>1</b> {t('home.ledger.cadence')}</p>
  </div>

  {hasDemo && <DemoBanner context="list" lang={lang} />}

  {
    latestIssue && (
      <section class="section reveal" aria-labelledby="latest-heading">
        <h2 class="kick kick--lead" id="latest-heading">
          {t('home.latestIssue', { issue: issueLabelIn(lang, latestIssue) })}
        </h2>
        <ul class="card-grid">
          {coverStory && <ArticleCard article={coverStory} feature eager lang={lang} />}
          {restOfIssue.map((article, i) => (
            <ArticleCard article={article} headingLevel="h3" lang={lang} />
          ))}
        </ul>
        <p class="more databar">
          <a href={withBase(localePath(lang, `/issues/${latestIssue}/`))}>{t('home.everything')}</a>
        </p>
      </section>
    )
  }

  {
    earlier.length > 0 && (
      <section class="section reveal" aria-labelledby="recent-heading">
        <h2 class="kick kick--lead" id="recent-heading">
          {t('home.archive')}
        </h2>
        <ul class="card-grid">
          {earlier.map((article) => (
            <ArticleCard article={article} lang={lang} />
          ))}
        </ul>
      </section>
    )
  }

  <section class="section reveal">
    <p class="more databar closing">
      <a href={withBase(localePath(lang, '/articles/'))}>{t('home.browseAll')}</a>
      <a href={withBase(localePath(lang, '/issues/'))}>{t('home.issueArchive')}</a>
    </p>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding-block: clamp(1.5rem, 5vw, 3.5rem) clamp(2rem, 5vw, 3rem);
  }

  .hero h1 {
    font-size: clamp(2.6rem, 6.2vw, 4.4rem);
    font-weight: 820;
    letter-spacing: -0.032em;
    line-height: 1.02;
    margin-top: 1.25rem;
  }

  /* the tonal counterpoint: serif italic in phosphor teal */
  .hero h1 em {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.012em;
    color: var(--accent);
    font-size: 0.99em;
  }

  .lede {
    margin-top: 1.4rem;
    font-family: var(--font-body);
    font-size: 1.16rem;
    line-height: 1.68;
    color: var(--text-muted);
    max-width: 34rem;
  }

  .cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  /* the crest, mounted like a framed exhibit with a hover-level float */
  .hero-crest {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
    justify-self: center;
  }

  .crest-frame {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background:
      radial-gradient(closest-side, var(--accent-soft), transparent),
      var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: var(--shadow);
    animation: hover-float 7s ease-in-out infinite;
  }

  .crest-frame img {
    width: clamp(9rem, 20vw, 14rem);
    filter: drop-shadow(0 10px 24px rgb(0 0 0 / 0.18));
  }

  @keyframes hover-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  .crest-bar {
    justify-content: center;
  }

  /* the ledger: a ruled strip of live counts under the masthead */
  .ledger {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2.5rem;
    padding-block: 0.95rem;
    border-block: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .ledger b {
    color: var(--accent);
    font-weight: 650;
    margin-right: 0.4em;
  }

  .more {
    margin-top: 1.75rem;
  }

  .more a {
    font-weight: 600;
  }

  .kick--lead {
    margin-bottom: 1.75rem;
  }

  .closing {
    gap: 0.75rem;
  }

  @media (max-width: 56rem) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-crest {
      order: -1;
      align-items: flex-start;
      justify-self: start;
    }

    .crest-frame {
      padding: 1.25rem;
    }

    .crest-frame img {
      width: 8rem;
    }

    .crest-bar {
      display: none;
    }
  }
</style>
