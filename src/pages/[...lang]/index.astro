---
import { localeStaticPaths, useTranslations } from '../../i18n/utils';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import DemoBanner from '../../components/DemoBanner.astro';
import JoinPanel from '../../components/JoinPanel.astro';
import CrestHero from '../../components/CrestHero.astro';
import { collectIssues, collectTags, getPublishedArticles, withBase } from '../../utils/articles';
import { issueLabelIn, localePath, tagLabel } from '../../i18n/utils';

const { lang } = Astro.props;
const t = useTranslations(lang);

const articles = await getPublishedArticles(lang);
const latestIssue = articles[0]?.data.issue;
const latestIssueArticles = articles.filter((a) => a.data.issue === latestIssue);
const [coverStory, ...restOfIssue] = latestIssueArticles;
const earlier = articles.filter((a) => a.data.issue !== latestIssue).slice(0, 6);
const hasDemo = articles.some((a) => a.data.demo);
const issues = collectIssues(articles);
const tags = collectTags(articles);

export const getStaticPaths = localeStaticPaths;
---

<Base lang={lang} title={t('home.title')} description={t('home.description')}>
  <section class="hero">
    <div class="hero-text">
      <p class="kick">{t('home.kick')}</p>
      <h1>
        <span class="h1-line">{t('home.h1.a')}</span>
        <span class="h1-line"><span class="h1-mark">{t('home.h1.b')}</span></span>
      </h1>
      <p class="lede">{t('home.lede')}</p>
      <div class="cta">
        {
          latestIssue && (
            <a class="button" href={withBase(localePath(lang, `/issues/${latestIssue}/`))}>
              {t('home.cta.latest')} <span class="button-arrow" aria-hidden="true">→</span>
            </a>
          )
        }
        <a class="button button--ghost" href={withBase(localePath(lang, '/about/'))}>
          {t('home.cta.about')}
        </a>
      </div>
    </div>

    <div class="hero-crest" aria-hidden="true">
      <CrestHero />
    </div>
  </section>

  <div class="ledger" role="list">
    <p role="listitem"><b>{articles.length}</b> {t('home.ledger.briefings')}</p>
    <p role="listitem">
      <b>{issues.length}</b>{' '}
      {issues.length === 1 ? t('home.ledger.issues_one') : t('home.ledger.issues_other')}
    </p>
    <p role="listitem"><b>{tags.length}</b> {t('home.ledger.topics')}</p>
    <p role="listitem"><b>1</b> {t('home.ledger.cadence')}</p>
  </div>

  {hasDemo && <DemoBanner context="list" lang={lang} />}

  {
    latestIssue && (
      <section class="section" aria-labelledby="latest-heading">
        <h2 class="kick kick--lead" id="latest-heading">
          {t('home.latestIssue', { issue: issueLabelIn(lang, latestIssue) })}
        </h2>
        <ul class="card-grid">
          {coverStory && <ArticleCard article={coverStory} feature eager lang={lang} />}
          {restOfIssue.map((article, i) => (
            <ArticleCard article={article} headingLevel="h3" lang={lang} />
          ))}
        </ul>
        <p class="more databar">
          <a href={withBase(localePath(lang, `/issues/${latestIssue}/`))}>{t('home.everything')}</a>
        </p>
      </section>
    )
  }

  {
    earlier.length > 0 && (
      <section class="section reveal" aria-labelledby="recent-heading">
        <h2 class="kick kick--lead" id="recent-heading">
          {t('home.archive')}
        </h2>
        <ul class="card-grid">
          {earlier.map((article) => (
            <ArticleCard article={article} lang={lang} />
          ))}
        </ul>
      </section>
    )
  }

  <section class="section closing reveal" aria-labelledby="closing-heading">
    <div class="closing-browse">
      <h2 id="closing-heading">{t('home.closing.h')}</h2>
      <p class="closing-copy">{t('home.closing.body')}</p>
      <ul class="chips" aria-label={t('article.tags')}>
        {tags.map((tag) => (
          <li style="display:contents">
            <a class="chip" href={withBase(localePath(lang, `/tags/${tag}/`))}>{tagLabel(lang, tag)}</a>
          </li>
        ))}
      </ul>
      <p class="closing-links">
        <a href={withBase(localePath(lang, '/articles/'))}>{t('home.browseAll')}</a>
        <a href={withBase(localePath(lang, '/issues/'))}>{t('home.issueArchive')}</a>
      </p>
    </div>
    <JoinPanel lang={lang} align="start" headingLevel="h2" />
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding-block: clamp(1.5rem, 5vw, 3.5rem) clamp(2rem, 5vw, 3rem);
  }

  .hero h1 {
    font-size: clamp(2.6rem, 6.2vw, 4.4rem);
    font-weight: 820;
    letter-spacing: -0.032em;
    line-height: 1.02;
    margin-top: 1.25rem;
  }

  .h1-line {
    display: block;
  }

  /* Japanese: break between phrases (文節), never mid-word, so the line
     can't strand a lone "で。" on a row of its own. */
  .hero h1:lang(ja) {
    word-break: auto-phrase;
    /* A whole phrase like 「デジタル安全を、」 is wider than a 320px phone at
       the Latin minimum size, and auto-phrase won't split it: size by the
       viewport instead, and allow an emergency break as a last resort. */
    font-size: clamp(2rem, 8.6vw, 4.4rem);
    overflow-wrap: anywhere;
  }

  /* A teal rule under the second line: the accent, without a faux italic
     (which Japanese can't take). One rule per wrapped line via
     box-decoration-break: clone. */
  .h1-mark {
    padding-bottom: 0.1em;
    background: linear-gradient(var(--accent), var(--accent)) left bottom / 100% 0.06em no-repeat;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .lede {
    margin-top: 1.4rem;
    font-family: var(--font-body);
    font-size: 1.16rem;
    line-height: 1.68;
    color: var(--text-muted);
    max-width: 34rem;
  }

  .cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  /* the crest column; the frame and its 3D scene live in CrestHero.astro */
  .hero-crest {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
    justify-self: center;
  }

  /* the ledger: a ruled strip of live counts under the masthead */
  .ledger {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2.5rem;
    padding-block: 0.95rem;
    border-block: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .ledger b {
    color: var(--accent);
    font-weight: 650;
    margin-right: 0.4em;
  }

  .more {
    margin-top: 1.75rem;
  }

  .more a {
    font-weight: 600;
  }

  .kick--lead {
    margin-bottom: 1.75rem;
  }

  /* the close of the page: topics to browse beside the invitation to join */
  .closing {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
    padding-top: clamp(2.5rem, 6vw, 3.5rem);
    border-top: 1px solid var(--line);
  }

  .closing-browse h2 {
    font-size: clamp(1.45rem, 3.6vw, 2rem);
  }

  .closing-copy {
    margin-top: 0.85rem;
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 1.08rem;
    max-width: 32rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
  }

  .closing-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
  }

  .closing-links a {
    font-weight: 650;
    text-decoration: none;
  }

  .closing-links a::after {
    content: ' →';
    font-family: var(--font-mono);
  }

  .closing-links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 56rem) {
    .hero,
    .closing {
      grid-template-columns: 1fr;
    }

    .hero-crest {
      order: -1;
      align-items: flex-start;
      justify-self: start;
    }

  }
</style>
