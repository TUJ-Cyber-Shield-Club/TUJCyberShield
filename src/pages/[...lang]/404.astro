---
// Fully rendered 404, one per locale — chrome, body and links all translated.
// The host serves the flat /404.html for unmatched paths; that file redirects
// here when the missed URL carried a locale prefix. See src/pages/404.astro.
import Base from '../../layouts/Base.astro';
import NotFound from '../../components/NotFound.astro';
import { PREFIXED_LOCALES } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';

// Only the prefixed locales. The default locale's 404 is the flat
// src/pages/404.astro, which is the file the host actually serves; emitting it
// here too would collide on the same /404 route.
export function getStaticPaths() {
  return PREFIXED_LOCALES.map((code) => ({ params: { lang: code }, props: { lang: code } }));
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base lang={lang} langTarget="/" title={t('notFound.title')} description={t('notFound.description')}>
  <NotFound lang={lang} />
</Base>

