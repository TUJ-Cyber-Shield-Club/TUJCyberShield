---
import { localeStaticPaths, useTranslations } from '../../i18n/utils';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import logo from '../../assets/logo.png';
import developer from '../../assets/team/carl-masters.jpg';
import { withBase } from '../../utils/articles';
import { localePath } from '../../i18n/utils';

const { lang } = Astro.props;
const t = useTranslations(lang);

const joinForm =
  'https://docs.google.com/forms/d/e/1FAIpQLSf8e37fWWAWD6axVy3mzr_sbEWz8ce-pZ0NZT-cZfEaTNVqkA/viewform?usp=header';

export const getStaticPaths = localeStaticPaths;
---

<Base
  lang={lang}
  title={t('about.title')}
  description={t('about.description')}
>
  <div class="about">
    <header class="masthead">
      <h1>{t('about.h1.a')} <em>{t('about.h1.b')}</em></h1>
    </header>

    <div class="logo-plate">
      <div class="crest corner-frame">
        <Image
          src={logo}
          alt={t('about.crestAlt')}
          width="360"
          loading="eager"
        />
      </div>
    </div>

    <div class="prose">
      <p>{t('about.p1')}</p>
      <p>{t('about.p2')}</p>

      <h2>{t('about.doH')}</h2>
      <ul>
        <li><strong>{t('about.do1L')}</strong> {t('about.do1')}</li>
        <li><strong>{t('about.do2L')}</strong> {t('about.do2')}</li>
        <li><strong>{t('about.do3L')}</strong> {t('about.do3')}</li>
        <li><strong>{t('about.do4L')}</strong> {t('about.do4')}</li>
      </ul>

      <h2>{t('about.joinH')}</h2>
      <p>
        {t('about.joinP1a')}
        <a href="https://www.instagram.com/tuj_cyber_shield_club/" target="_blank" rel="noopener"
          >@tuj_cyber_shield_club</a
        >{t('about.joinP1b')}
      </p>
      <p class="join-cta">
        <a class="button" href={joinForm} target="_blank" rel="noopener">
          {t('join.cta')} <span class="button-arrow" aria-hidden="true">→</span>
        </a>
      </p>

      <p>
        {t('about.readFirstA')}
        <a href={withBase(localePath(lang, '/articles/'))}>{t('about.readFirstBrowse')}</a>{t('about.readFirstOr')}
        <a href={withBase(localePath(lang, '/team/'))}>{t('about.readFirstTeam')}</a>.
      </p>
    </div>

    <section class="developer reveal" aria-labelledby="developer-heading">
      <h2 id="developer-heading">{t('about.devH2')}</h2>
      <div class="developer-card">
        <div class="avatar-frame">
          <Image
            class="dev-avatar"
            src={developer}
            alt={t('about.devPhotoAlt')}
            width="220"
            height="220"
            fit="cover"
            loading="lazy"
          />
        </div>
        <div class="prose dev-bio">
          <!-- EDIT ME, Carl: personalize this bio and swap in a real photo at
               src/assets/team/carl-masters.jpg -->
          <p>
            {t('about.devP1a')}
            <strong
              ><a href="https://carlmasters.com" target="_blank" rel="noopener">Carl Masters</a
              ></strong
            >{t('about.devP1b')}
          </p>
          <p>
            {t('about.devP2a')}
            <a href="mailto:carl.masters.dev@protonmail.com">carl.masters.dev@protonmail.com</a>.
          </p>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .about {
    max-width: 46rem;
    margin-inline: auto;
  }

  .masthead {
    text-align: center;
  }

  .masthead h1 {
    font-size: clamp(2rem, 5.4vw, 3.1rem);
  }

  .masthead h1 em {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
  }

  /* Japanese has no italic; the browser would slant the mincho artificially. */
  .masthead h1 em:lang(ja) {
    font-style: normal;
  }

  /* The full crest mounted in a dark specimen frame, captioned like an exhibit. */
  .logo-plate {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
    margin-block: 2.5rem;
  }

  .logo-plate .databar {
    justify-content: center;
  }

  .logo-plate .crest {
    padding: clamp(1.75rem, 4vw, 2.75rem) clamp(1.5rem, 6vw, 4rem);
    background:
      radial-gradient(ellipse 60% 80% at 50% 45%, rgb(76 200 196 / 0.1), transparent),
      var(--ink);
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .prose {
    margin-inline: auto;
  }

  .join-cta {
    margin-block: 1.5rem;
  }

  .developer {
    max-width: 46rem;
    margin: clamp(3.5rem, 9vw, 5rem) auto 0;
    padding-top: clamp(2.25rem, 5vw, 3.25rem);
    border-top: 1px solid var(--line);
  }

  .developer h2 {
    font-size: 1.7rem;
  }

  .developer-card {
    display: flex;
    gap: 1.6rem;
    margin-top: 1.6rem;
    align-items: flex-start;
    padding: 1.4rem;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .avatar-frame {
    flex: 0 0 auto;
    padding: 0.35rem;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--bg-inset);
  }

  .dev-avatar {
    width: 5.6rem;
    height: 5.6rem;
    border-radius: 5px;
    background: var(--bg-inset);
    object-fit: cover;
  }

  .dev-bio {
    margin: 0;
    min-width: 0;
    font-size: 1.04rem;
    /* the email address is one long unbreakable word on a 320px phone */
    overflow-wrap: anywhere;
  }

  @media (max-width: 34rem) {
    .developer-card {
      flex-direction: column;
      gap: 1.1rem;
    }
  }
</style>
